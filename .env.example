# Portas publicadas pelo Docker Compose
FRONT_PORT=8080
BACK_PORT=3000

# Opcional: somente localhost; use 0.0.0.0 para permitir acesso pela rede local
FRONT_HOST=127.0.0.1

# Opcional: usado somente com compose.tunnel.yaml
CLOUDFLARE_TUNNEL_TOKEN=

# Limites globais de upload por instância do backend
MAX_CONCURRENT_UPLOADS=2
UPLOAD_RATE_LIMIT=10
UPLOAD_RATE_WINDOW_SECONDS=60
