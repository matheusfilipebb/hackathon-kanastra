{
  "name": "antecipe-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "comparar": "tsx scripts/comparar-resultado.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/swagger": "^9.8.2",
    "@fastify/swagger-ui": "^6.1.2",
    "fastify": "^5.12.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
